+# How a PX4 command reaches the running PX4 instance.
+if [ -n "$PX4_STARTUP_FD" ]
+then
+	# PX4 is running this script itself and executes the commands written to
+	# the given file descriptor. The reply is the command's output, then a
+	# line with its return value.
+	#
+	# The two descriptors after it are a pipe holding one line. Reading that
+	# line reserves the channel, so that a command put in the background
+	# cannot get the reply of another.
+	_px4_lock_fd=$((PX4_STARTUP_FD + 1))
+	_px4_unlock_fd=$((PX4_STARTUP_FD + 2))
+
+	_px4_cmd() {
+		read -r _px4_reply <&"$_px4_lock_fd"
+		echo "$*" >&"$PX4_STARTUP_FD"
+		_px4_rc=1
+
+		while IFS= read -r _px4_reply <&"$PX4_STARTUP_FD"
+		do
+			case "$_px4_reply" in
+			"__px4_rc "*)
+				_px4_rc="${_px4_reply#__px4_rc }"
+				break
+				;;
+			*) echo "$_px4_reply" ;;
+			esac
+		done
+
+		echo >&"$_px4_unlock_fd"
+		return "$_px4_rc"
+	}
+	px4_cmd_prefix="_px4_cmd "
+	px4_cmd_suffix=""
+else
+	# Each command is a client binary (a symlink to px4) that connects to the
+	# socket of the PX4 instance.
+	px4_cmd_prefix="@PREFIX@"
+	px4_cmd_suffix=" --instance $px4_instance"
+fi
+
+@alias_string@
