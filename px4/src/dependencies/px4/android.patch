+/**
+ * @file startup_script.cpp
+ */
+
+#include "startup_script.h"
+
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <fcntl.h>
+#include <poll.h>
+#include <pthread.h>
+#include <spawn.h>
+#include <sys/socket.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <string>
+
+#include <px4_platform_common/log.h>
+
+#include "pxh.h"
+#include "server.h"
+
+extern char **environ;
+
+namespace px4_daemon
+{
+
+// Descriptor numbers in the shell: the command channel, followed by the read
+// and the write end of the pipe that serves as its lock.
+static constexpr int SHELL_CHANNEL_FD = 3;
+static constexpr int SHELL_LOCK_READ_FD = SHELL_CHANNEL_FD + 1;
+static constexpr int SHELL_LOCK_WRITE_FD = SHELL_CHANNEL_FD + 2;
+
+// Above the descriptors of the shell, so that setting those up cannot
+// overwrite one that is still to be duplicated.
+static constexpr int FIRST_FREE_FD = 10;
+
+static constexpr int POLL_INTERVAL_MS = 100;
+static constexpr int QUIET_AFTER_EXIT_MS = 500;
+
+// Line with which the reply to a command ends, followed by its return value.
+// Has to match px4-alias.sh.
+static constexpr const char *RETURN_MARKER = "__px4_rc ";
+
+static bool send_all(int fd, const char *buf, size_t n)
+{
+	while (n > 0) {
+		// The shell may be gone, which must not raise SIGPIPE.
+#if defined(MSG_NOSIGNAL)
+		ssize_t n_written = send(fd, buf, n, MSG_NOSIGNAL);
+#else
+		ssize_t n_written = send(fd, buf, n, 0);
+#endif
+
+		if (n_written < 0) {
+			return false;
+		}
+
+		buf += n_written;
+		n -= n_written;
+	}
+
+	return true;
+}
+
+int run_startup_script_in_process(const std::string &commands_file, int instance)
+{
+	if (!Server::has_pthread_key()) {
+		PX4_ERR("startup script needs a server instance");
+		return -1;
+	}
+
+	// A script may run commands in the background, which then use the channel
+	// at the same time as the script itself. One process would read the reply
+	// meant for the other, so the shell functions take turns: whoever reads
+	// the one line in this pipe has the channel, and writes the line back
+	// when done.
+	int fds[2];
+	int lock_fds[2];
+
+	if (socketpair(AF_UNIX, SOCK_STREAM, 0, fds) != 0) {
+		PX4_ERR("socketpair() failed: %s", strerror(errno));
+		return -1;
+	}
+
+	if (pipe(lock_fds) != 0) {
+		PX4_ERR("pipe() failed: %s", strerror(errno));
+		close(fds[0]);
+		close(fds[1]);
+		return -1;
+	}
+
+	// Everything is close-on-exec: the shell only gets the duplicates made
+	// below, and our end of the channel must not leak into it, or it would
+	// never be seen to close.
+	const int channel_fd = fcntl(fds[0], F_DUPFD_CLOEXEC, FIRST_FREE_FD);
+	const int shell_fd = fcntl(fds[1], F_DUPFD_CLOEXEC, FIRST_FREE_FD);
+	const int lock_read_fd = fcntl(lock_fds[0], F_DUPFD_CLOEXEC, FIRST_FREE_FD);
+	const int lock_write_fd = fcntl(lock_fds[1], F_DUPFD_CLOEXEC, FIRST_FREE_FD);
+	close(fds[0]);
+	close(fds[1]);
+	close(lock_fds[0]);
+	close(lock_fds[1]);
+
+	if (channel_fd < 0 || shell_fd < 0 || lock_read_fd < 0 || lock_write_fd < 0
+	    || write(lock_write_fd, "\n", 1) != 1) {
+		PX4_ERR("failed to set up the command channel: %s", strerror(errno));
+		close(channel_fd);
+		close(shell_fd);
+		close(lock_read_fd);
+		close(lock_write_fd);
+		return -1;
+	}
+
+#if !defined(MSG_NOSIGNAL) && defined(SO_NOSIGPIPE)
+	int no_sigpipe = 1;
+	setsockopt(channel_fd, SOL_SOCKET, SO_NOSIGPIPE, &no_sigpipe, sizeof(no_sigpipe));
+#endif
+
+	setenv(STARTUP_SCRIPT_FD_ENV, std::to_string(SHELL_CHANNEL_FD).c_str(), 1);
+
+	posix_spawn_file_actions_t actions;
+	posix_spawn_file_actions_init(&actions);
+	posix_spawn_file_actions_adddup2(&actions, shell_fd, SHELL_CHANNEL_FD);
+	posix_spawn_file_actions_adddup2(&actions, lock_read_fd, SHELL_LOCK_READ_FD);
+	posix_spawn_file_actions_adddup2(&actions, lock_write_fd, SHELL_LOCK_WRITE_FD);
+
+	const std::string instance_arg = std::to_string(instance);
+	char *const argv[] = {
+		(char *)"sh", (char *)commands_file.c_str(), (char *)instance_arg.c_str(), nullptr
+	};
+
+	pid_t pid;
+	int ret = posix_spawn(&pid, "/bin/sh", &actions, nullptr, argv, environ);
+	posix_spawn_file_actions_destroy(&actions);
+	close(shell_fd);
+	close(lock_read_fd);
+	close(lock_write_fd);
+	unsetenv(STARTUP_SCRIPT_FD_ENV);
+
+	if (ret != 0) {
+		PX4_ERR("failed to start /bin/sh: %s", strerror(ret));
+		close(channel_fd);
+		return -1;
+	}
+
+	// PX4_INFO() and friends print to the stdout registered for the calling
+	// thread, as they do for the commands of a client.
+	Server::CmdThreadSpecificData thread_data{nullptr, false};
+	pthread_setspecific(Server::get_pthread_key(), &thread_data);
+
+	// The script is done when its shell has exited. The channel closing is
+	// not the sign: programs the script leaves running hold it open too. A
+	// command it put in the background may however still be due, so the
+	// channel is served until it has been quiet for a moment.
+	std::string received;
+	bool shell_exited = false;
+	int status = 0;
+
+	while (true) {
+		const size_t line_end = received.find('\n');
+
+		if (line_end == std::string::npos) {
+			pollfd channel{channel_fd, POLLIN, 0};
+			const int n_ready = poll(&channel, 1, shell_exited ? QUIET_AFTER_EXIT_MS : POLL_INTERVAL_MS);
+
+			if (n_ready > 0) {
+				char buffer[1024];
+				const ssize_t n_read = read(channel_fd, buffer, sizeof(buffer));
+
+				if (n_read <= 0) {
+					break;
+				}
+
+				received.append(buffer, n_read);
+
+			} else if (shell_exited) {
+				break;
+
+			} else if (waitpid(pid, &status, WNOHANG) == pid) {
+				shell_exited = true;
+			}
+
+			continue;
+		}
+
+		const std::string command = received.substr(0, line_end);
+		received.erase(0, line_end + 1);
+
+		// The output goes back in one piece once the command has returned.
+		char *output = nullptr;
+		size_t output_size = 0;
+		thread_data.thread_stdout = open_memstream(&output, &output_size);
+
+		const int retval = Pxh::process_line(command, true);
+
+		fclose(thread_data.thread_stdout);
+		thread_data.thread_stdout = nullptr;
+
+		// The shell reads line by line, so the marker has to start one.
+		std::string reply(output, output_size);
+		free(output);
+
+		if (!reply.empty() && reply.back() != '\n') {
+			reply += '\n';
+		}
+
+		// Same range as the exit status a client would report.
+		reply += RETURN_MARKER + std::to_string((uint8_t)retval) + '\n';
+
+		if (!send_all(channel_fd, reply.data(), reply.size())) {
+			break;
+		}
+	}
+
+	close(channel_fd);
+	pthread_setspecific(Server::get_pthread_key(), nullptr);
+
+	if (!shell_exited && waitpid(pid, &status, 0) != pid) {
+		PX4_ERR("waitpid() failed: %s", strerror(errno));
+		return -1;
+	}
+
+	return WIFEXITED(status) ? WEXITSTATUS(status) : -1;
+}
+
+} // namespace px4_daemon
