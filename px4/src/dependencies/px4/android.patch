+/**
+ * @file pthread_cancel.h
+ *
+ * pthread_cancel() for the C libraries that do not have it.
+ */
+#pragma once
+
+#include <pthread.h>
+
+#if defined(__BIONIC__)
+
+#include <signal.h>
+
+static inline void px4_pthread_cancel_handler(int)
+{
+	pthread_exit(nullptr);
+}
+
+/**
+ * Android's C library has no thread cancellation. Stand in for it with a
+ * signal whose handler ends the thread. Unlike a cancellation this does not
+ * wait for a cancellation point, the thread ends wherever it is.
+ */
+static inline int px4_pthread_cancel(pthread_t thread)
+{
+	struct sigaction action {};
+	action.sa_handler = px4_pthread_cancel_handler;
+	sigemptyset(&action.sa_mask);
+	sigaction(SIGUSR2, &action, nullptr);
+
+	return pthread_kill(thread, SIGUSR2);
+}
+
+#else
+
+static inline int px4_pthread_cancel(pthread_t thread)
+{
+	return pthread_cancel(thread);
+}
+
+#endif // __BIONIC__
