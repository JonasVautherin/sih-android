+/**
+ * @file startup_script.h
+ *
+ * Runs the startup script without the px4-* client binaries.
+ */
+#pragma once
+
+#include <string>
+
+namespace px4_daemon
+{
+
+/**
+ * Environment variable through which the startup shell learns the file
+ * descriptor of its command channel. px4-alias.sh keys on it. The two
+ * descriptors after it are the read and the write end of the channel's lock.
+ */
+static constexpr const char *STARTUP_SCRIPT_FD_ENV = "PX4_STARTUP_FD";
+
+/**
+ * Run a startup script with the system shell, executing its PX4 commands in
+ * the calling thread.
+ *
+ * The shell normally reaches PX4 by starting a px4-<command> client per
+ * command, which connects to the Server socket. Here it gets one end of a
+ * socket pair instead: each PX4 command in the script is a shell function
+ * that writes the command line to it and reads back the output and the
+ * return value. Nothing but the shell itself is executed, so this works
+ * where the client binaries cannot be installed or run.
+ *
+ * Commands run one at a time, including those the script puts in the
+ * background.
+ *
+ * Requires a Server instance for the per-thread stdout, which need not be
+ * started.
+ *
+ * @param commands_file the script to run
+ * @param instance instance ID, passed to the script as its first argument
+ * @return exit status of the shell, or negative on failure to run it
+ */
+int run_startup_script_in_process(const std::string &commands_file, int instance);
+
+} // namespace px4_daemon
